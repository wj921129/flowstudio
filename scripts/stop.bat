@echo off
setlocal
title FlowStudio - Stop
cd /d "%~dp0\.."

echo ========================================================
echo   FlowStudio - Stop
echo ========================================================

powershell -NoProfile -Command "$root=(Get-Location).Path.Replace('\','/'); $procs=Get-CimInstance Win32_Process -ErrorAction Stop; $byId=@{}; foreach($p in $procs){ $byId[[int]$p.ProcessId]=$p }; $self=@{}; $cur=[int]$PID; while($cur -and $byId.ContainsKey($cur) -and -not $self.ContainsKey($cur)){ $self[$cur]=$true; $cur=[int]$byId[$cur].ParentProcessId }; $portPids=@(Get-NetTCPConnection -LocalPort 3000,5173 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { [int]$_.OwningProcess } | Select-Object -Unique); $targets=@($procs | Where-Object { $pidInt=[int]$_.ProcessId; if($self.ContainsKey($pidInt)){ return $false }; $c=if($_.CommandLine){ $_.CommandLine.Replace('\','/') }else{ '' }; if($c -like '*flowstudio-mcp.cjs*'){ return $false }; if($portPids -contains $pidInt){ return $true }; if($_.Name -in @('node.exe','pnpm.exe','tsx.exe','esbuild.exe')){ return ($c -like ('*'+$root+'*') -or $c -like '*packages/server/dist/index.js*' -or $c -like '*packages/web*vite*') }; if($_.Name -in @('cmd.exe','powershell.exe','pwsh.exe')){ return ($c -like ('*'+$root+'*start.bat*') -or $c -like ('*'+$root+'*dev-all.bat*') -or $c -like '*scripts/start.bat*' -or $c -like '*scripts/dev-all.bat*' -or $c -like '*pnpm dev*' -or $c -like '*pnpm dev:server*' -or $c -like '*packages/server/dist/index.js*') }; return $false }); $extra=@(); foreach($t in $targets){ $ppid=[int]$t.ParentProcessId; if($ppid -and -not $self.ContainsKey($ppid) -and $byId.ContainsKey($ppid)){ $parent=$byId[$ppid]; $pc=if($parent.CommandLine){ $parent.CommandLine.Replace('\','/') }else{ '' }; if($parent.Name -in @('cmd.exe','powershell.exe','pwsh.exe','pnpm.exe') -and ($pc -like ('*'+$root+'*') -or $pc -like '*packages/server*' -or $pc -like '*pnpm dev*' -or $pc -like '*start.bat*' -or $pc -like '*dev-all.bat*')){ $extra+=$parent } } }; $all=@(($targets+$extra) | Sort-Object ProcessId -Unique); if(-not $all){ Write-Host 'No running FlowStudio processes found.'; exit 0 }; Write-Host 'Found FlowStudio processes:'; foreach($t in $all){ $p=(Get-NetTCPConnection -State Listen -OwningProcess $t.ProcessId -ErrorAction SilentlyContinue).LocalPort -join ','; $c=$t.CommandLine; if($c -and $c.Length -gt 110){ $c=$c.Substring(0,110)+'...' }; Write-Host ('  PID {0}  [{1}]  port[{2}]  {3}' -f $t.ProcessId,$t.Name,$p,$c) }; $ans=Read-Host 'Stop all listed processes? (y/N)'; if($ans -ne 'y' -and $ans -ne 'Y'){ Write-Host 'Cancelled.'; exit 0 }; foreach($t in $all){ & taskkill /PID $t.ProcessId /T /F 2>$null | Out-Null; Stop-Process -Id $t.ProcessId -Force -ErrorAction SilentlyContinue }; Start-Sleep -Milliseconds 500; $left=@($all | Where-Object { Get-Process -Id $_.ProcessId -ErrorAction SilentlyContinue }); if($left){ $isAdmin=([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator); if(-not $isAdmin){ $ids=($left | ForEach-Object { $_.ProcessId }) -join ','; Write-Host ('Elevated privileges required for PID(s): '+$ids+'. Requesting Administrator permission...'); $elevCmd='$pids=@('+$ids+'); $procs=Get-CimInstance Win32_Process -EA SilentlyContinue; $byId=@{}; foreach($p in $procs){ $byId[[int]$p.ProcessId]=$p }; $kill=@(); foreach($id in $pids){ $kill+=$id; if($byId.ContainsKey($id)){ $pp=[int]$byId[$id].ParentProcessId; if($pp -and $byId.ContainsKey($pp)){ $par=$byId[$pp]; $pc=if($par.CommandLine){ $par.CommandLine.Replace([char]92,''/'') }else{ '''' }; if($par.Name -in @(''cmd.exe'',''powershell.exe'',''pwsh.exe'',''pnpm.exe'') -and ($pc -like ''*flowstudio*'' -or $pc -like ''*packages/server*'' -or $pc -like ''*pnpm dev*'' -or $pc -like ''*start.bat*'' -or $pc -like ''*dev-all.bat*'')){ $kill+=$pp } } } }; foreach($k in ($kill | Select-Object -Unique)){ & taskkill /PID $k /T /F 2>$null | Out-Null; Stop-Process -Id $k -Force -EA SilentlyContinue }'; $b64=[Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($elevCmd)); try { Start-Process powershell -Verb RunAs -Wait -WindowStyle Hidden -ArgumentList @('-NoProfile','-EncodedCommand',$b64) } catch { Write-Host 'Elevation cancelled or failed.' }; Start-Sleep -Milliseconds 500; $left=@($all | Where-Object { Get-Process -Id $_.ProcessId -ErrorAction SilentlyContinue }) } }; if($left){ Write-Host ('Warning: failed to stop PID(s): '+($left.ProcessId -join ',')) } else { Write-Host 'FlowStudio stopped.' }"

if %errorlevel% neq 0 echo [Error] Stop script failed.
pause